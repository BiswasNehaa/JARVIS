# Groq API key (the "brain", free tier) — get one at https://console.groq.com/keys
GROQ_API_KEY=

# Picovoice AccessKey (wake word engine) — free, get one at https://console.picovoice.ai/
PICOVOICE_ACCESS_KEY=

# Optional: override the default model
GROQ_MODEL=llama-3.3-70b-versatile

# Optional, for later: switch the brain back to Claude once you have paid API access.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5
