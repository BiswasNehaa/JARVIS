# Groq API key (the "brain", free tier) — get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the default model
GROQ_MODEL=openai/gpt-oss-120b

# Optional, for later: switch the brain back to Claude once you have paid API access.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5

# Wake word ("Hey Jarvis") runs via openWakeWord — fully offline, free, no key needed.
# One-time setup: python -c "from openwakeword.utils import download_models; download_models()"
