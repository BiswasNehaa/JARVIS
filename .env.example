# Groq API key (the "brain", free tier) — get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the default model
GROQ_MODEL=openai/gpt-oss-120b

# Your name, so JARVIS addresses you correctly instead of "sir"
USER_NAME=Neha

# Voice — change and rerun to hear a different one.
# Browse options: https://speech.microsoft.com/portal/voicegallery
TTS_VOICE=en-CA-LiamNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# Optional, for later: switch the brain back to Claude once you have paid API access.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5

# Wake word ("Hey Jarvis") runs via openWakeWord — fully offline, free, no key needed.
# One-time setup: python -c "from openwakeword.utils import download_models; download_models()"
